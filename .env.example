# Postgres (with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thriftly
DB_USER=postgres
DB_PASSWORD=

# eBay application keys (developer.ebay.com -> Application Keys)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# eBay marketplace account deletion endpoint
EBAY_VERIFICATION_TOKEN=
EBAY_ENDPOINT_URL=https://your-domain.example/ebay/deletion

# Gemini embeddings
GEMINI_API_KEY=

# Search agent (Gemini). AGENT_RPM caps generate calls/minute: 5 on the free
# tier; raise it once billing is enabled.
AGENT_MODEL=gemini-3.5-flash
AGENT_RPM=5

# Alert emails (src/notify.py). console = print only (default), file = write
# .eml files to outbox/, smtp = send for real with the settings below.
EMAIL_BACKEND=console
EMAIL_FROM=Thriftly <alerts@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Web app (src/api.py). COOKIE_SECURE=true once served over HTTPS.
COOKIE_SECURE=false
SESSION_DAYS=30
DB_POOL_MAX=10
